# Web Content Analyzer - Environment Configuration
# Copy this file to .env and update the values as needed

# ===== APPLICATION SETTINGS =====
ENVIRONMENT=development
DEBUG=true
LOG_LEVEL=INFO

# ===== SERVER CONFIGURATION =====
# Backend API settings
API_HOST=0.0.0.0
API_PORT=8000
BACKEND_URL=http://localhost:8000

# Frontend settings
FRONTEND_HOST=0.0.0.0
FRONTEND_PORT=8501
STREAMLIT_SERVER_HEADLESS=false

# ===== SECURITY SETTINGS =====
# Rate limiting
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW=3600
RATE_LIMIT_ENABLED=true

# Content security
MAX_CONTENT_SIZE=10485760
REQUEST_TIMEOUT=30
SSRF_PROTECTION=true
XSS_PROTECTION=true

# ===== PROCESSING SETTINGS =====
# Analysis features
ENABLE_DEEP_ANALYSIS=true
ENABLE_SENTIMENT_ANALYSIS=true
ENABLE_KEYWORD_EXTRACTION=true
ENABLE_METADATA_EXTRACTION=true

# Performance settings
MAX_CONCURRENT_REQUESTS=5
MAX_WORKERS=4
PROCESSING_TIMEOUT=120

# ===== CACHING SETTINGS =====
CACHE_ENABLED=true
CACHE_TTL=3600
REDIS_URL=redis://localhost:6379

# ===== MONITORING SETTINGS =====
ENABLE_METRICS=true
HEALTH_CHECK_INTERVAL=30
PROMETHEUS_ENABLED=false

# ===== DATABASE SETTINGS (Future use) =====
# DATABASE_URL=sqlite:///./web_analyzer.db
# DATABASE_POOL_SIZE=10

# ===== EXTERNAL SERVICES (Future use) =====
# OPENAI_API_KEY=your_openai_api_key_here
# ANTHROPIC_API_KEY=your_anthropic_api_key_here

# ===== FILE STORAGE =====
UPLOAD_DIR=./uploads
TEMP_DIR=./temp
MAX_FILE_SIZE=50MB

# ===== LOGGING SETTINGS =====
LOG_FORMAT=json
LOG_FILE=./logs/app.log
LOG_ROTATION=daily
LOG_RETENTION=30

# ===== DEVELOPMENT SETTINGS =====
# Only used in development
DEV_AUTO_RELOAD=true
DEV_DEBUG_MODE=true
DEV_CORS_ORIGINS=http://localhost:3000,http://localhost:8501

# ===== PRODUCTION SETTINGS =====
# Only used in production
PROD_SSL_ENABLED=true
PROD_SSL_CERT_PATH=/etc/ssl/certs/cert.pem
PROD_SSL_KEY_PATH=/etc/ssl/private/key.pem
PROD_WORKERS=4

# ===== FEATURE FLAGS =====
FEATURE_EXPORT_PDF=true
FEATURE_EXPORT_EXCEL=true
FEATURE_BATCH_PROCESSING=false
FEATURE_API_AUTHENTICATION=false

OPENAI_API_KEY=open ai key here
GEMINI_API_KEY=gemini key here