# Web Content Analyzer - Environment Configuration
# Backend Environment Variables

# Application Settings
ENVIRONMENT=development
DEBUG=true
API_TITLE=Web Content Analyzer
API_VERSION=1.0.0

# Server Configuration
HOST=0.0.0.0
PORT=8000
RELOAD=true

# Security Settings
ALLOWED_ORIGINS=http://localhost:8501,http://frontend:8501
MAX_CONTENT_SIZE=10485760
REQUEST_TIMEOUT=30
MAX_REQUESTS_PER_MINUTE=60

# Logging
LOG_LEVEL=INFO

# Content Processing
MIN_CONTENT_LENGTH=100
MAX_TEXT_SIZE=5242880
MAX_KEYWORDS=20
