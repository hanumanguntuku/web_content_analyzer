{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Python Debugger: FastAPI",
            "type": "debugpy",
            "request": "launch",
            "module": "uvicorn",
            "args": [
                "main:app",
                "--reload"
            ],
            "jinja": true
        },
        {
            "name": "Python: FastAPI (backend/main.py)",
            "type": "python",
            "request": "launch",
            "program": "${workspaceFolder}/web_content_analyze/web_content_analyzer/backend/main.py",
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}/web_content_analyze/web_content_analyzer/backend",
            "env": {
                "PYTHONPATH": "${workspaceFolder}/web_content_analyze/web_content_analyzer/backend"
            },
            "args": [
                "--host",
                "127.0.0.1",
                "--port",
                "8000",
                "--reload"
            ],
            "jinja": true,
            "justMyCode": false,
            "debugOptions": [
                "RedirectOutput"
            ]
        }
    ]
}